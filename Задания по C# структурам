    public SimpleDate(int day, int month, int year)
    {
        Day = day;
        Month = month;
        Year = year;
    }

    public bool IsLeapYear()
    {
        if (Year % 400 == 0) return true;
        if (Year % 100 == 0) return false;
        if (Year % 4 == 0) return true;
        return false;
    }

    public void Print()
    {
        Console.WriteLine(Day + "." + Month + "." + Year);
    }
}

