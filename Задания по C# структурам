struct Triangle
{
    public Point A;
    public Point B;
    public Point C;

    public Triangle(Point a, Point b, Point c)
    {
        A = a;
        B = b;
        C = c;
    }

    private double Distance(Point p1, Point p2)
    {
        double dx = p2.X - p1.X;
        double dy = p2.Y - p1.Y;
        return Math.Sqrt(dx * dx + dy * dy);
    }

    public double SideAB() { return Distance(A, B); }
    public double SideBC() { return Distance(B, C); }
    public double SideCA() { return Distance(C, A); }

    public double Perimeter()
    {
        return SideAB() + SideBC() + SideCA();
    }

    public double Area()
    {
        double a = SideAB();
        double b = SideBC();
        double c = SideCA();
        double p = (a + b + c) / 2;
        return Math.Sqrt(p * (p - a) * (p - b) * (p - c));
    }
}

