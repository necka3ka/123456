struct Money
{
    public long Rubles;
    public int Kopecks;

    public Money(long rubles, int kopecks)
    {
        Rubles = rubles;
        Kopecks = kopecks;
        Normalize();
    }

    private void Normalize()
    {
        if (Kopecks >= 100)
        {
            Rubles += Kopecks / 100;
            Kopecks = Kopecks % 100;
        }
        else if (Kopecks < 0)
        {
            long borrow = (-Kopecks + 99) / 100;
            Rubles -= borrow;
            Kopecks += (int)(borrow * 100);
        }
    }

    public Money Add(Money other)
    {
        return new Money(Rubles + other.Rubles, Kopecks + other.Kopecks);
    }

    public Money Sub(Money other)
    {
        return new Money(Rubles - other.Rubles, Kopecks - other.Kopecks);
    }

    private long ToKopecks()
    {
        return Rubles * 100 + Kopecks;
    }

    public bool IsGreater(Money other)
    {
        return ToKopecks() > other.ToKopecks();
    }

    public bool IsLess(Money other)
    {
        return ToKopecks() < other.ToKopecks();
    }

    public void Print()
    {
        Console.WriteLine(Rubles + " руб. " + Kopecks + " коп.");
    }
}

